{
  "name": "basile-skills",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/clash-royale/cr-profile.ts --target node --minify --banner '#!/usr/bin/env node' --outfile skills/clash-royale-strategies/scripts/cr-profile.mjs",
    "cr:profile": "node skills/clash-royale-strategies/scripts/cr-profile.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run fmt:check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
